{
  "name": "patient-search",
  "private": true,
  "scripts": {
    "dev": "concurrently --names \"api,web\" --prefix-colors \"cyan,magenta\" \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "cd backend && .venv/bin/python app.py",
    "dev:web": "cd frontend && npm run dev",
    "seed": "cd backend && .venv/bin/python seed_db.py"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
